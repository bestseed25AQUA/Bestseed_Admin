{
	"info": {
		"name": "BestSeeds - Vendor (Hatchery) App",
		"description": "API collection for the BestSeeds Vendor/Hatchery mobile application.\n\nAuthentication: best_seeds_id + password → Sanctum Bearer Token.\nMiddleware: auth:sanctum + CheckVendorActive\n\nBase URL: {{base_url}}/api/vendor\n\nAlso includes Driver APIs under /api/driver prefix.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://aqua.bestseed.in",
			"type": "string"
		},
		{
			"key": "vendor_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "driver_token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{vendor_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Vendor Authentication",
			"item": [
				{
					"name": "Vendor Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('vendor_token', json.token);",
									"    }",
									"    if (json.require_password_reset) {",
									"        pm.collectionVariables.set('vendor_id_for_reset', json.vendor_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"best_seeds_id\": \"BS001\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vendor/login",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "login"]
						},
						"description": "Login with BestSeeds ID and password. First login returns require_password_reset=true."
					}
				},
				{
					"name": "Set New Password (First Login)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vendor_id\": 1,\n    \"new_password\": \"newpassword123\",\n    \"new_password_confirmation\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vendor/set-new-password",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "set-new-password"]
						},
						"description": "Set new password on first login. new_password: min 8 chars, must be confirmed."
					}
				},
				{
					"name": "Vendor Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "logout"]
						}
					}
				}
			]
		},
