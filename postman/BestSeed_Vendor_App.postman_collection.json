		{
			"name": "Vendor Bookings (Dashboard)",
			"item": [
				{
					"name": "Get Bookings",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings?tab=new&search=&category_id=&location_id=&booking_type=&status=&vehicle_availability=&page=1",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings"],
							"query": [
								{ "key": "tab", "value": "new", "description": "new|current|tracking|past" },
								{ "key": "search", "value": "", "disabled": true },
								{ "key": "category_id", "value": "", "disabled": true },
								{ "key": "location_id", "value": "", "disabled": true },
								{ "key": "booking_type", "value": "", "description": "hatchery|spot|vehicle|vehicle_availability", "disabled": true },
								{ "key": "status", "value": "", "description": "1-6", "disabled": true },
								{ "key": "vehicle_availability", "value": "", "description": "assigned|not_assigned", "disabled": true },
								{ "key": "page", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Accept Booking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/accept",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "accept"],
							"variable": [
								{ "key": "id", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Reject Booking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason_code\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/reject",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "reject"],
							"variable": [
								{ "key": "id", "value": "1" }
							]
						},
						"description": "Reason codes: 1=Delay in processing, 2=Incorrect order, 3=Wrong quantity, 4=Stock quality, 5=Other"
					}
				},
				{
					"name": "Update Booking",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"no_of_pieces\": 1000,\n    \"salinity\": \"25\",\n    \"dropping_location\": \"Updated Location\",\n    \"packing_date\": \"2026-04-01\",\n    \"price\": 5000,\n    \"delivery_datetime\": \"2026-04-02\",\n    \"vendor_booking_description\": \"Booking notes\",\n    \"vendor_vehicle_description\": \"Vehicle details\",\n    \"driver_name\": \"Driver Name\",\n    \"driver_mobile\": \"9876543210\",\n    \"vehicle_number\": \"TS01AB1234\",\n    \"drop_lat\": 17.385,\n    \"drop_lng\": 78.4867,\n    \"status\": 2,\n    \"delivery_reason\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/update",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "update"],
							"variable": [
								{ "key": "id", "value": "1" }
							]
						},
						"description": "Status: 2=In Progress, 3=Confirmed, 4=Driver Assigned, 5=Delivered, 6=Cancelled"
					}
				},
				{
					"name": "Remove Driver from Booking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/remove-driver",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "remove-driver"],
							"variable": [
								{ "key": "id", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Change Driver",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"driver_id\": 1,\n    \"driver_name\": \"New Driver\",\n    \"driver_mobile\": \"9876543210\",\n    \"vehicle_number\": \"TS01AB1234\",\n    \"vehicle_start_date\": \"2026-04-01\",\n    \"vehicle_end_date\": \"2026-04-02\",\n    \"vehicle_start_lat\": 17.385,\n    \"vehicle_start_lng\": 78.4867,\n    \"vehicle_start_address\": \"Start Point Address\",\n    \"priority\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/change-driver",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "change-driver"],
							"variable": [
								{ "key": "id", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Booking Vehicle Tracking",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/bookings/:id/tracking",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "bookings", ":id", "tracking"],
							"variable": [
								{ "key": "id", "value": "480", "description": "Booking ID" }
							]
						},
						"description": "Fetch vehicle tracking data for a specific booking.\n\nResponse includes route_waypoints (priority-ordered multi-stop locations) for polyline drawing."
					}
				},
				{
					"name": "Get Drivers List",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/drivers",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "drivers"]
						}
					}
				},
				{
					"name": "Tracking Alert Status (All Drivers)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{vendor_token}}", "type": "string" }]
						},
						"method": "GET",
						"description": "Returns tracking alert history for all drivers under this vendor's active (In Journey) bookings.\n\nAlerts are stored with timestamps and shown in descending order (newest first).\nAlerts are only cleared when a booking is delivered (status 5) or cancelled (status 6).\n\nResponse includes:\n- id: alert ID\n- booking_id\n- driver_id, driver_name, driver_mobile\n- reason: alert reason (e.g. GPS off, back online)\n- location_name: last known location\n- time: timestamp of the alert",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/api/vendor/tracking-alert-status",
							"host": ["{{base_url}}"],
							"path": ["api", "vendor", "tracking-alert-status"]
						}
					}
				}
			]
		},
