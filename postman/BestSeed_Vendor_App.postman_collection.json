							"bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }]
						},
						"method": "POST",
						"description": "Flutter sends this when driver's GPS, network, or permissions change.\n\nissue_type values:\n- gps_off: Driver turned off GPS/Location\n- internet_off: Driver internet connection is down\n- permission_denied: Location permissions not enabled\n- tracking_stopped: Device stopped sending location\n- tracking_restarted: Tracking resumed (clears the alert)\n\nThis saves the reason in driver_inactive_reason column and sends FCM notification to vendor.\nReason auto-clears when driver sends location update.",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"issue_type\": \"gps_off\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/driver/tracking-alert",
							"host": ["{{base_url}}"],
							"path": ["api", "driver", "tracking-alert"]
						}
					}
				}
			]
		}
	]
}