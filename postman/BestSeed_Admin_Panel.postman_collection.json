{
	"info": {
		"name": "BestSeeds - Admin Panel (Web)",
		"description": "API/Web routes collection for the BestSeeds Admin Panel.\n\nAuthentication: Session-based (email + password + 2FA OTP).\nMiddleware: auth + IsAdmin\n\nNote: Admin panel uses web routes (session cookies). Set cookies after login.\n\nBase URL: {{base_url}}/admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://aqua.bestseed.in",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Admin panel uses session cookies - ensure cookies are enabled in Postman"
				],
				"type": "text/javascript"
			}
		}
	],
	"item": [
		{
			"name": "Authentication & OTP",
			"item": [
				{
					"name": "Login Page",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "Returns the login form. Extract CSRF token from response."
					}
				},
				{
					"name": "Login (Submit)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
							{ "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "_token", "value": "{{csrf_token}}", "type": "text" },
								{ "key": "email", "value": "admin@example.com", "type": "text" },
								{ "key": "password", "value": "password", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "Submit login credentials. On success, redirects to OTP page."
					}
				},
				{
					"name": "OTP Verification Page",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/admin/otp",
							"host": ["{{base_url}}"],
							"path": ["admin", "otp"]
						}
					}
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "_token", "value": "{{csrf_token}}", "type": "text" },
								{ "key": "otp", "value": "123456", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/admin/otp",
							"host": ["{{base_url}}"],
							"path": ["admin", "otp"]
						}
					}
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "_token", "value": "{{csrf_token}}", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/admin/otp/resend",
							"host": ["{{base_url}}"],
							"path": ["admin", "otp", "resend"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "_token", "value": "{{csrf_token}}", "type": "text" }
							]
						},
						"url": {
							"raw": "{{base_url}}/logout",
							"host": ["{{base_url}}"],
							"path": ["logout"]
						}
					}
				}
			]
		},
